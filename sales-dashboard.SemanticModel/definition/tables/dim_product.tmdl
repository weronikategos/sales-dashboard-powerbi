	partition dim_product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"product_id", Int64.Type}, {"product", type text}, {"category", type text}, {"list_price", type number}, {"stock", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table


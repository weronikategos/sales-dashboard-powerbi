	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"customer_id", Int64.Type}, {"customer", type text}, {"signup_date", type date}, {"first_order_month", type text}, {"orders_count", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

